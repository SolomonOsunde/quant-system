# Copy this to .env and fill in your credentials
# Never commit .env to git

# === Anthropic ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# === Forex — OANDA ===
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here

# === Equities — Alpaca ===
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# === Crypto — Binance (no key needed for public WebSocket) ===
BINANCE_API_KEY=optional_for_trading
BINANCE_API_SECRET=optional_for_trading

# === Commodities — Interactive Brokers ===
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# === Database ===
DATABASE_URL=postgresql://quant:quant123@localhost:5432/quantdb
REDIS_HOST=localhost
REDIS_PORT=6379
