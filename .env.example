# Copy this to .env and fill in your credentials
# Never commit .env to git

# === Anthropic ===
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# === Database (instrument universe lives here) ===
DATABASE_URL=postgresql://quant:quant123@localhost:5432/quantdb
REDIS_HOST=localhost
REDIS_PORT=6379

# === Forex — OANDA practice (required for live FX; no simulation) ===
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_PRACTICE=true

# === Crypto / Equity — Alpaca paper (required; no simulation) ===
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# === Live testing gates ===
PAPER_TRADING=true
ALLOW_SIMULATION=false
REQUIRE_FILL_ACK=true
STRESS_SLIPPAGE=true
ALERT_WEBHOOK_URL=
MIN_CONFIDENCE=0.65
MAX_ORDER_USD=5000
MAX_POSITION_USD=50000
